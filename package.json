{
  "name": "youtublur",
  "version": "1.12.14",
  "description": "YouTubeを、もっと目に優しく。動画のブラー背景でやわらかな視聴体験を提供するChrome拡張機能です。",
  "main": "content.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "vp test",
    "pretest:coverage": "tsc",
    "test:coverage": "vp test --coverage --run",
    "test:e2e": "playwright test",
    "verify:ai-blur": "node e2e/ai-verify/capture-blur-evidence.mjs",
    "version": "node scripts/sync-version.js && git add manifest.json",
    "release": "commit-and-tag-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyto64/youtublur.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kyto64/youtublur/issues"
  },
  "homepage": "https://github.com/kyto64/youtublur#readme",
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/chrome": "0.2.2",
    "@vitest/coverage-v8": "4.1.10",
    "@voidzero-dev/vite-plus-core": "0.2.5",
    "@voidzero-dev/vite-plus-test": "0.1.24",
    "chrome-webstore-upload": "6.0.0",
    "commit-and-tag-version": "12.7.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite-plus": "0.2.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.0.16",
      "undici": "7.28.0"
    }
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
