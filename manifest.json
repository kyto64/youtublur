{
  "manifest_version": 3,
  "name": "youtublur",
  "version": "2.0",
  "description": "YouTubeを、もっと目に優しく。動画のブラー背景でやわらかな視聴体験を。",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "youtublur"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ]
}