{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "removeComments": false,
    "newLine": "lf",
    "types": ["chrome"]
  },
  "include": ["src/**/*.ts", "globals.d.ts"],
  "exclude": ["node_modules", "e2e", "scripts", "playwright.config.js", "vite.config.ts"]
}
